STUDIO_USERNAME=ADMIN
STUDIO_PASSWORD=CHANGE_ME_123
# Recommended: a salted scrypt hash instead of STUDIO_PASSWORD. Generate with:
#   npm run hash-password
# Legacy SHA-256 hex digests still work and are upgraded to scrypt on the next login.
# STUDIO_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-secret
PORT=8787
# Sessions are stored in server/data/sessions.json and survive restarts.
# Idle timeout (minutes, sliding) and absolute lifetime (days).
# SESSION_IDLE_MINUTES=45
# SESSION_MAX_DAYS=7
# Public base URL used for RSS, sitemap.xml and canonical links (defaults to the request host).
# SITE_URL=https://blog.example.com/
# Language used for feed titles/descriptions and share-page meta: zh | en | ja | ko
# SITE_LANGUAGE=zh
# Set to "production" in real deployments (adds the Secure flag to the session cookie)
# NODE_ENV=production
# Which proxies may set X-Forwarded-For. Default: loopback (Nginx on the same host).
# Use 1 behind a single hosted proxy (Render, Railway, Fly), or false if exposed directly.
# TRUST_PROXY=loopback
