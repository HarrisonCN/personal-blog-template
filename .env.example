STUDIO_USERNAME=ADMIN
STUDIO_PASSWORD=CHANGE_ME_123
# Optional: use a SHA-256 hex string instead of STUDIO_PASSWORD
# STUDIO_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-secret
PORT=8787
# Set to "production" in real deployments (adds the Secure flag to the session cookie)
# NODE_ENV=production
# Which proxies may set X-Forwarded-For. Default: loopback (Nginx on the same host).
# Use 1 behind a single hosted proxy (Render, Railway, Fly), or false if exposed directly.
# TRUST_PROXY=loopback
