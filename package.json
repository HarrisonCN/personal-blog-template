{
  "name": "xos-future-blog",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build --base ./",
    "preview": "vite preview",
    "start": "node server.js",
    "deploy:cloudflare": "npm run build && npx wrangler deploy",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm test && npm run build",
    "hash-password": "node scripts/hash-password.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "vite": "^7.1.7"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
